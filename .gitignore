# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
# NOTE: *.import IS versioned (Godot best practice) — it stores per-asset import
# settings (e.g. mipmaps) that must travel with the repo. Only .godot/imported/
# (the generated cache) is ignored, via the .godot/ rule above.
export.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/IDE
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/
game.log

# Performance test logs
*.log
performance*.log

# Node dependency caches (vendored MCP server etc.) — never commit
node_modules/
