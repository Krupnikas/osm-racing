Пробел — ручной тормоз

C — переключение камеры
ПКМ + мышь — вращение камеры
Колёсико — зум

N — ночной режим · R — дождь
G — неон под машиной · M — следующий трек

Escape — меню паузы"
theme_type_variation = &"MonoLabel"
theme_override_font_sizes/font_size = 13
theme_override_constants/line_spacing = 4
modulate = Color(0.643, 0.678, 0.745, 1)
horizontal_alignment = 0

[node name="Spacer2" type="Control" parent="SettingsPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="BackButton" type="Button" parent="SettingsPanel/VBox"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Назад"

[node name="LoadingPanel" type="Panel" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="LoadingPanel"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -120.0
offset_right = 300.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2

[node name="Title" type="Label" parent="LoadingPanel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "Загрузка..."
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="LoadingPanel/VBox"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2

[node name="ProgressBar" type="ProgressBar" parent="LoadingPanel/VBox"]
custom_minimum_size = Vector2(600, 40)
layout_mode = 2
value = 0.0
show_percentage = false

[node name="StatusLabel" type="Label" parent="LoadingPanel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Загрузка карты..."
horizontal_alignment = 1

[node name="CarSelection" parent="." instance=ExtResource("3_car_selection")]

[node name="LocationSelect" parent="." instance=ExtResource("4_loc_select")]

[node name="RaceSelect" parent="." instance=ExtResource("11_race_select")]

[node name="CareerMenu" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("6_career_menu")

[node name="TrackDisplay" type="CanvasLayer" parent="."]
script = ExtResource("5_track_display")

[node name="LoadingScreen" parent="." instance=ExtResource("12_loading")]
visible = false
z_index = 100

